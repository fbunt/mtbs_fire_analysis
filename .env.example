# Machine-specific data root. Copy this file to `.env` and set the path.
# paths.py reads FIRE_DATA_ROOT and expects `<root>/data` and `<root>/data_tmp`.
# Precedence: a shell env var overrides this .env, which overrides the server
# default in paths.py. Leave unset (no .env) to use that default.
FIRE_DATA_ROOT=/path/to/fire_analysis

# --- Catalog adapter (jlab client) ---
# When enabled, paths.py serves the 12 catalog-backed inputs from the platform
# store via the jlab client instead of the FIRE_DATA_ROOT layout above; scratch,
# results, cache and get_points_path stay on FIRE_DATA_ROOT.
# JLAB_ROOT is the platform root (its <root>/index holds catalog.parquet).
# JLAB_API_URL is an optional STAC API base; the client falls back to the index.
#JLAB_ROOT=/path/to/platform/store
#JLAB_API_URL=http://127.0.0.1:8085
# FIRE_CATALOG forces the adapter on/off: 1/true/on enable, 0/false/off disable.
# When unset, the adapter is enabled iff JLAB_ROOT or JLAB_API_URL is set.
#FIRE_CATALOG=1
# FIRE_CATALOG_PROFILE selects the platform profile the adapter binds to. The
# profile's [inputs] table maps each input ROLE to a collection, so the adapter
# carries no collection literal. Default is wave0-gate (the wave-0 imports).
# Switch to `fire` once the wave-1 products exist (platform S9/S10); until then
# `fire` resolves no products.
#FIRE_CATALOG_PROFILE=wave0-gate
